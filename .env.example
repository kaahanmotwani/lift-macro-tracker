# -----------------------------------------------------------------------------
# Copy to .env.local for local development. In production these are set in the
# Vercel dashboard (Project → Settings → Environment Variables).
# -----------------------------------------------------------------------------

# From Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 32 random bytes, base64. Used to encrypt each user's Anthropic API key at rest.
# Generate one with:  openssl rand -base64 32
# Changing this makes every stored API key unreadable — users would re-enter theirs.
APP_ENCRYPTION_KEY=

# Optional. If set, the app falls back to this key for users who haven't added
# their own. Leave EMPTY unless you intend to pay for other people's AI usage.
# ANTHROPIC_API_KEY=

# Optional. Public URL of your deployment, used to build auth redirect links.
# Vercel sets this automatically in production; only needed for custom domains.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
